  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npx prisma db push && npx prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsx --test __tests__/*.test.ts",

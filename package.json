    "golden-dataset": "npx tsx scripts/generate-golden-dataset.ts",
    "trace": "npx tsx scripts/trace.ts",
    "replay": "npx tsx scripts/replay.ts",
    "worker:ingestion": "npx tsx src/workers/ingestion.ts",
    "worker:pipeline": "npx tsx src/workers/pipelineProcessor.ts",
    "seed": "npx tsx scripts/seed-knowledge-base.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:ingestion\" \"npm run worker:pipeline\""
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.62",

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// CORE DOMAIN: Opportunity
// -----------------------------------------------------------------------------

model Opportunity {
  id             String    @id @default(uuid())
  platformId     String    @unique // e.g. Upwork job ID
  platform       String    @default("UPWORK") // UPWORK, LINKEDIN, etc.
  status         String    @default("PENDING") // PENDING, EVALUATING, APPLIED, REJECTED
  
  jobPosting     JobPosting?
  score          OpportunityScore?
  decision       OpportunityDecision?
  proposal       Proposal?
  
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  
  pipelineRuns   PipelineRun[]
  agentRuns      AgentRun[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model JobPosting {
  id               String      @id @default(uuid())
  opportunityId    String      @unique
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  title            String
  description      String
  budget           Float?
  hourlyMin        Float?
  hourlyMax        Float?
  skills           String      // Comma separated
  postedAt         DateTime
  
  // Platform specific raw metrics (to be normalized later if needed)
  jobInvitesSent   Int?
  jobInterviewing  Int?
  jobAvgBid        Float?
  jobConnectsCost  Int?
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// -----------------------------------------------------------------------------
// CORE DOMAIN: Client
// -----------------------------------------------------------------------------

model Client {
  id             String         @id @default(uuid())
  platformId     String         @unique // pseudo-hash or actual company_id
  platform       String         @default("UPWORK")
  
  name           String?
  status         String         @default("NEUTRAL") // NEUTRAL, FAVORITE, BLACKLISTED
  notes          String?
  
  profile        ClientProfile?
  opportunities  Opportunity[]
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ClientProfile {
  id               String   @id @default(uuid())
  clientId         String   @unique
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  totalSpend       Float?
  avgHourlyRate    Float?
  feedbackScore    Float?
  totalContracts   Int?
  activeContracts  Int?
  location         String?
  
  historyJson      String?  // Store raw history array if needed
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// CORE DOMAIN: Scoring & Decisions
// -----------------------------------------------------------------------------

model OpportunityScore {
  id                  String      @id @default(uuid())
  opportunityId       String      @unique
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  skillMatch          Float
  portfolioFit        Float
  projectQuality      Float
  longTermPotential   Float
  
  redFlags            String      // JSON Array
  missingRequirements String      // JSON Array
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model OpportunityDecision {
  id                  String      @id @default(uuid())
  opportunityId       String      @unique
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  recommendation      String      // APPLY, MAYBE, SKIP
  reason              String
  confidence          Float?
  
  positiveEvidence    String?     // JSON Array
  negativeEvidence    String?     // JSON Array
  missingInformation  String?     // JSON Array
  
  createdAt           DateTime    @default(now())
}

model Proposal {
  id             String      @id @default(uuid())
  opportunityId  String      @unique
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  content        String
  evidenceUsed   String?     // JSON array of FreelancerEvidence IDs used
  status         String      @default("DRAFT") // DRAFT, SUBMITTED
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model FreelancerEvidence {
  id              String   @id @default(uuid())
  type            String   // PROJECT, TECHNOLOGY, ACHIEVEMENT, CASE_STUDY, METRIC
  title           String
  description     String
  technologies    String   // Comma-separated
  url             String?  // Proof/Source
  embedding       String?  // Stored as JSON string of float array
  verification    String   // e.g., "Verified via GitHub", "Verified via Upwork"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PIPELINE & TELEMETRY
// -----------------------------------------------------------------------------

model PipelineRun {
  id             String      @id @default(uuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  stage          String      // INGEST, NORMALIZE, DEDUPLICATE, ENRICH, ANALYZE, SCORE, DECIDE, PROPOSAL
  status         String      // PENDING, PROCESSING, COMPLETED, FAILED
  
  error          String?
  metadata       String?     // JSON string for stage context
  startedAt      DateTime?
  completedAt    DateTime?
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  @@index([opportunityId, stage])
  @@index([status])
}

model AgentRun {
  id             String       @id @default(uuid())
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  
  agentName      String
  provider       String       // gemini, openai
  model          String
  schemaVersion  String       @default("1.0")
  retries        Int          @default(0)
  
  promptTokens   Int?
  completionTokens Int?
  durationMs     Int?
  
  inputPayload   String       // JSON
  outputPayload  String?      // JSON
  error          String?
  
  createdAt      DateTime     @default(now())
}

// -----------------------------------------------------------------------------
// EVALUATION
// -----------------------------------------------------------------------------

model Evidence {
  id             String       @id @default(uuid())
  type           String       // PORTFOLIO_PROJECT, WORK_HISTORY
  title          String
  description    String
  metrics        String       // JSON Array of verified metrics
  
  createdAt      DateTime     @default(now())
}

model Evaluation {
  id             String       @id @default(uuid())
  agentRunId     String       @unique
  
  isAccurate     Boolean
  humanFeedback  String?
  
  createdAt      DateTime     @default(now())
}
